<div class="container mt-5 ml-2">
  <div class="card">
    <div class="card-header">
      <h2><%= t('editing') %> <%= Carpool.model_name.human(count: 1) %></h2>
    </div>
    <div class="card-body">
      <%= render 'form', carpool: @carpool %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to t('links.show'), @carpool, class: "btn btn-success" %>
    <%= link_to t('links.back'), carpools_path, class: "btn btn-secondary" %>
  </div>
</div>
