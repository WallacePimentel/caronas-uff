<%= form_with(model: carpool, local: true) do |form| %>
  <% if carpool.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><%= pluralize(carpool.errors.count, "error") %> prohibited this carpool from being saved:</h4>
      <ul class="mb-0">
        <% carpool.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :driver, class: "font-weight-bold"%>
    <%= form.text_field :driver, class: "form-control"%>
  </div>

  <div class="form-group">
    <%= form.label :passengers, class: "font-weight-bold"%>
    <%= form.select :passengers, options_for_select(1..4)%>
  </div>

  <div class="form-group">
    <%= form.label :price_per_person, class: "font-weight-bold"%>
    <%= form.select :price_per_person, options_for_select((0..15).map { |n| n.to_f }) %>
  </div>

  <div class="form-group">
    <%= form.label :beginning_campus_id, class: "font-weight-bold" %>
    <%= form.select :beginning_campus_id, @campus_options, { prompt: true }, { class: "form-control" } %>
  </div>

  <div class="form-group">
    <h5 class="font-weight-bold"><%= Place.model_name.human(count: :other) %></h5>
    <%= form.fields_for :places do |place|%>
      <%= render 'place_fields', f: place %>
    <% end %>
    <div class="mt-3">
      <%= link_to_add_association t('links.add.place'), form, :places, class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :ending_campus_id, class: "font-weight-bold" %>
    <%= form.select :ending_campus_id, @campus_options, { prompt: true }, { class: "form-control" } %>
  </div>

  <div class="form-group">
    <%= form.label :departure_time, class: "font-weight-bold" %>
    <%= form.datetime_select :departure_time, { default: Time.current } %>
  </div>

  <div class="form-group">
    <%= form.label :observation, class: "font-weight-bold"%>
    <%= form.text_field :observation, class: "form-control"%>
  </div>

  <div class="form-group mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
