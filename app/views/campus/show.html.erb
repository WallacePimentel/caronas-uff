<div class="container mt-5">
  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <h1><strong><%= t('details') %> <%= Campu.model_name.human %></strong></h1>
  
  <ul class="list-group mt-3">
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:description) %>:</strong> <%= @campu.description %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:street_adress) %>:</strong> <%= @campu.street_adress %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:number) %>:</strong> <%= @campu.number %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:district) %>:</strong> <%= @campu.district %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:city) %>:</strong> <%= @campu.city %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:CEP) %>:</strong> <%= @campu.CEP %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:status) %>:</strong> <%= @campu.status.capitalize %></li>
    <li class="list-group-item"><strong><%= Campu.human_attribute_name(:deactivation_date) %>:</strong> <%= @campu.deactivation_date.strftime(t('datetime.formats.default')) if @campu.deactivation_date %></li>
  </ul>

  <div class="mt-3">
    <%= link_to t('links.edit'), edit_campu_path(@campu), class: "btn btn-warning" %>
    <%= link_to t('links.back'), campus_path, class: "btn btn-secondary text-light" %>
  </div>
</div>