<div class="container mt-5 ml-2"> 
  <p id="notice"><%= notice %></p>

  <h1><strong>Campus</strong></h1>

  <table class="table table-striped">
    <thead>
      <tr>
        <th><%= Campu.human_attribute_name(:description) %></th>
        <th><%= Campu.human_attribute_name(:street_adress) %></th>
        <th><%= Campu.human_attribute_name(:number) %></th>
        <th><%= Campu.human_attribute_name(:district) %></th>
        <th><%= Campu.human_attribute_name(:city) %></th>
        <th><%= Campu.human_attribute_name(:CEP) %></th>
        <th><%= Campu.human_attribute_name(:status) %></th>
        <th><%= Campu.human_attribute_name(:deactivation_date) %></th>
        <th colspan="4"></th>
      </tr>
    </thead>

    <tbody>
      <% @campus.each do |campu| %>
        <tr>
          <td><%= campu.description %></td>
          <td><%= campu.street_adress %></td>
          <td><%= campu.number %></td>
          <td><%= campu.district %></td>
          <td><%= campu.city %></td>
          <td><%= campu.CEP %></td>
          <td><%= campu.status.capitalize %></td>
          <td><%= campu.deactivation_date.strftime(t('datetime.formats.default')) if campu.deactivation_date %></td>
          <td><%= link_to t('links.show'), campu , class: "btn btn-success" %></td>
          <td><%= link_to t('links.edit'), edit_campu_path(campu), class: "btn btn-warning" %></td>
          <td><%= button_to campu_path(campu), method: :delete, data: { confirm: t('messages.confirmation.are_you_sure') }, 
          class: "btn btn-danger", form: { class: "d-inline"} do %>
            <i class  ="bi bi-trash3-fill"></i> <span><%= t('links.destroy') %></span>
          <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>

  <%= link_to t('links.new.campus'), new_campu_path, class: "btn btn-primary text-light" %>
</div>